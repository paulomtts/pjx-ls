{
  "name": "pyjinhx-syntax-support",
  "displayName": "PyJinHx",
  "description": "Syntax highlighting and template formatting for the PyJinHx Python framework (PascalCase component tags, slots, {#def#} headers, interpolation).",
  "version": "0.5.1",
  "publisher": "paulomtts",
  "license": "MIT",
  "type": "module",
  "main": "./dist/extension.cjs",
  "icon": "icons/icon.png",
  "engines": { "vscode": "^1.80.0" },
  "repository": { "type": "git", "url": "https://github.com/paulomtts/pjx-ls.git" },
  "bugs": { "url": "https://github.com/paulomtts/pjx-ls/issues" },
  "homepage": "https://github.com/paulomtts/pjx-ls#readme",
  "keywords": [
    "pyjinhx",
    "jinja",
    "jinja2",
    "html",
    "template",
    "components",
    "formatter",
    "syntax highlighting",
    "python"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "check": "tsc --noEmit",
    "test": "node --test \"test/core/**/*.test.ts\" \"test/grammar/**/*.test.ts\" \"test/vscode/**/*.test.ts\"",
    "test:editor": "npm run build && node test/editor/run.mjs",
    "package": "npm run check && npm run build && vsce package"
  },
  "activationEvents": [
    "onLanguage:pyjinhx"
  ],
  "categories": ["Formatters", "Programming Languages"],
  "contributes": {
    "commands": [
      { "command": "pyjinhx.formatSlots", "title": "PyJinHx: Format Slotted Component Tags" },
      { "command": "pyjinhx.refreshManifest", "title": "PyJinHx: Refresh Component Manifest" },
      { "command": "pyjinhx.showOutput", "title": "PyJinHx: Show Output" }
    ],
    "languages": [
      {
        "id": "pyjinhx",
        "extensions": [".pjx"],
        "aliases": ["PyJinHx", "pjx"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/file.png",
          "dark": "./icons/file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "pyjinhx",
        "scopeName": "text.pyjinhx",
        "path": "./syntaxes/pyjinhx.json",
        "embeddedLanguages": {
          "source.css": "css",
          "source.js": "javascript",
          "source.python": "python"
        },
        "tokenTypes": { "meta.tag string.quoted": "other" }
      },
      { "scopeName": "source.pyjinhx.jinja", "path": "./syntaxes/pyjinhx-jinja.json" },
      { "scopeName": "pyjinhx.injection", "path": "./syntaxes/pyjinhx-injection.json", "injectTo": ["text.pyjinhx", "source.python"] },
      { "scopeName": "pyjinhx.python-template", "path": "./syntaxes/pyjinhx-python-template.json", "injectTo": ["source.python"], "embeddedLanguages": { "meta.embedded.block.pyjinhx": "pyjinhx", "source.css": "css", "source.js": "javascript" } },
      { "scopeName": "pyjinhx.injection.comments", "path": "./syntaxes/pyjinhx-injection-comments.json", "injectTo": ["text.pyjinhx", "source.python"] },
      { "scopeName": "pyjinhx.injection.attributes", "path": "./syntaxes/pyjinhx-injection-attributes.json", "injectTo": ["text.pyjinhx", "source.python"] }
    ],
    "configuration": {
      "title": "PyJinHx",
      "properties": {
        "pyjinhx.pythonPath": { "type": "string", "default": "", "scope": "machine-overridable", "markdownDescription": "The Python interpreter that has pyjinhx installed. Empty: the Python extension's environment, then `.venv` in the workspace folder, then `python3` on `PATH`. `${workspaceFolder}` is replaced." },
        "pyjinhx.manifest.paths": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Folders or files to read components from, relative to the workspace folder. Empty: the whole folder." },
        "pyjinhx.manifest.sysPath": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Directories modules are imported from (`--sys-path`), relative to the workspace folder; they decide how a component's module is named." }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": { "supported": "limited", "description": "In an untrusted workspace no Python interpreter is run: tags and props come from the .pjx files only.", "restrictedConfigurations": ["pyjinhx.pythonPath"] },
    "virtualWorkspaces": { "supported": "limited", "description": "Manifest features need a local Python; highlighting and HTML/CSS/JS forwarding work." }
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "mocha": "^11.8.0",
    "typescript": "^5.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
