{
  "name": "PyJinHx",
  "scopeName": "text.pyjinhx",
  "patterns": [
    {
      "include": "#pyjinhx-raw"
    },
    {
      "include": "#pyjinhx-block-def-legacy"
    },
    {
      "include": "#pyjinhx-block-python"
    },
    {
      "include": "#pyjinhx-block-css"
    },
    {
      "include": "#pyjinhx-block-js"
    },
    {
      "include": "#pyjinhx-block-def"
    },
    {
      "include": "#pyjinhx-comment"
    },
    {
      "include": "#pyjinhx-component-tag"
    },
    {
      "include": "source.pyjinhx.jinja"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "pyjinhx-component-tag": {
      "patterns": [
        {
          "begin": "(</?)([A-Z][A-Za-z0-9]*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.pyjinhx"
            },
            "2": {
              "name": "entity.name.tag.pyjinhx"
            }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.tag.end.pyjinhx"
            }
          },
          "patterns": [
            {
              "include": "source.pyjinhx.jinja"
            },
            {
              "begin": "\"(?=\\s*$)",
              "beginCaptures": {
                "0": {
                  "name": "string.quoted.double.html punctuation.definition.string.begin.html"
                }
              },
              "end": "\"",
              "endCaptures": {
                "0": {
                  "name": "string.quoted.double.html punctuation.definition.string.end.html"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "begin": "\"(?=\\s*</?[A-Za-z])",
              "beginCaptures": {
                "0": {
                  "name": "string.quoted.double.html punctuation.definition.string.begin.html"
                }
              },
              "end": "\"",
              "endCaptures": {
                "0": {
                  "name": "string.quoted.double.html punctuation.definition.string.end.html"
                }
              },
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "begin": "\"",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.string.begin.html"
                }
              },
              "end": "\"",
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.string.end.html"
                }
              },
              "name": "string.quoted.double.html",
              "patterns": [
                {
                  "include": "source.pyjinhx.jinja"
                }
              ]
            },
            {
              "match": "'[^']*'",
              "name": "string.quoted.single.html"
            },
            {
              "match": "([a-zA-Z_][\\w:-]*)(?=\\s*=)",
              "name": "entity.other.attribute-name.html"
            }
          ]
        }
      ]
    },
    "pyjinhx-comment": {
      "name": "comment.block.pyjinhx",
      "begin": "\\{#-?",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.pyjinhx"
        }
      },
      "end": "-?#\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.pyjinhx"
        }
      }
    },
    "pyjinhx-block-def": {
      "name": "meta.block.def.pyjinhx",
      "begin": "(\\{#)(def)(?=\\s|$|#\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.block.begin.pyjinhx"
        },
        "2": {
          "name": "keyword.control.pyjinhx"
        }
      },
      "end": "#\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.pyjinhx"
        }
      },
      "contentName": "meta.embedded.block.python source.python",
      "patterns": [
        {
          "begin": "(^|\\G)(?!.*#\\})",
          "while": "(^|\\G)(?!.*#\\})",
          "patterns": [
            {
              "match": "\\b([A-Za-z_]\\w*)\\b(?=\\s*:(?!:))",
              "captures": {
                "1": {
                  "name": "variable.parameter.pyjinhx"
                }
              }
            },
            {
              "include": "source.python"
            }
          ]
        },
        {
          "match": "(?!#\\})(.+?)(?=#\\})",
          "captures": {
            "1": {
              "patterns": [
                {
                  "match": "\\b([A-Za-z_]\\w*)\\b(?=\\s*:(?!:))",
                  "captures": {
                    "1": {
                      "name": "variable.parameter.pyjinhx"
                    }
                  }
                },
                {
                  "include": "source.python"
                }
              ]
            }
          }
        }
      ]
    },
    "pyjinhx-block-def-legacy": {
      "name": "meta.block.def.pyjinhx",
      "begin": "\\A(\\{#)(?:[ \\t]+)(def)(?=\\s|$|#\\})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.block.begin.pyjinhx"
        },
        "2": {
          "name": "keyword.control.pyjinhx"
        }
      },
      "end": "#\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.pyjinhx"
        }
      },
      "contentName": "meta.embedded.block.python source.python",
      "patterns": [
        {
          "begin": "(^|\\G)(?!.*#\\})",
          "while": "(^|\\G)(?!.*#\\})",
          "patterns": [
            {
              "match": "\\b([A-Za-z_]\\w*)\\b(?=\\s*:(?!:))",
              "captures": {
                "1": {
                  "name": "variable.parameter.pyjinhx"
                }
              }
            },
            {
              "include": "source.python"
            }
          ]
        },
        {
          "match": "(?!#\\})(.+?)(?=#\\})",
          "captures": {
            "1": {
              "patterns": [
                {
                  "match": "\\b([A-Za-z_]\\w*)\\b(?=\\s*:(?!:))",
                  "captures": {
                    "1": {
                      "name": "variable.parameter.pyjinhx"
                    }
                  }
                },
                {
                  "include": "source.python"
                }
              ]
            }
          }
        }
      ]
    },
    "pyjinhx-block-css": {
      "name": "meta.block.css.pyjinhx",
      "begin": "(\\{#)(css)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.block.begin.pyjinhx"
        },
        "2": {
          "name": "keyword.control.pyjinhx"
        }
      },
      "end": "#\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.pyjinhx"
        }
      },
      "contentName": "meta.embedded.block.css source.css",
      "patterns": [
        {
          "begin": "(^|\\G)(?!.*#\\})",
          "while": "(^|\\G)(?!.*#\\})",
          "patterns": [
            {
              "include": "source.css"
            }
          ]
        },
        {
          "match": "(?!#\\})(.+?)(?=#\\})",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "source.css"
                }
              ]
            }
          }
        }
      ]
    },
    "pyjinhx-block-js": {
      "name": "meta.block.js.pyjinhx",
      "begin": "(\\{#)(js)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.block.begin.pyjinhx"
        },
        "2": {
          "name": "keyword.control.pyjinhx"
        }
      },
      "end": "#\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.pyjinhx"
        }
      },
      "contentName": "meta.embedded.block.js source.js",
      "patterns": [
        {
          "begin": "(^|\\G)(?!.*#\\})",
          "while": "(^|\\G)(?!.*#\\})",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "match": "(?!#\\})(.+?)(?=#\\})",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "source.js"
                }
              ]
            }
          }
        }
      ]
    },
    "pyjinhx-block-python": {
      "name": "meta.block.python.pyjinhx",
      "begin": "^(\\{#)(python)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.block.begin.pyjinhx"
        },
        "2": {
          "name": "keyword.control.pyjinhx"
        }
      },
      "end": "#\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.pyjinhx"
        }
      },
      "contentName": "meta.embedded.block.python source.python",
      "patterns": [
        {
          "begin": "(^|\\G)(?!.*#\\})",
          "while": "(^|\\G)(?!.*#\\})",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "match": "(?!#\\})(.+?)(?=#\\})",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "source.python"
                }
              ]
            }
          }
        }
      ]
    },
    "pyjinhx-raw": {
      "name": "meta.scope.jinja.raw",
      "begin": "\\{%[-+]?\\s*raw\\s*-?%\\}",
      "end": "\\{%[-+]?\\s*endraw\\s*[-+]?%\\}"
    }
  }
}
